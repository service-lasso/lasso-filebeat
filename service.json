{
  "id": "filebeat",
  "name": "Filebeat",
  "description": "Release-backed Filebeat log shipper for Service Lasso apps.",
  "version": "8.14.2",
  "enabled": false,
  "depend_on": ["openobserve"],
  "ports": {
    "service": 5066
  },
  "portmapping": {
    "http": "${SERVICE_PORT}"
  },
  "env": {
    "FILEBEAT_HTTP_HOST": "127.0.0.1",
    "FILEBEAT_HTTP_PORT": "${SERVICE_PORT}",
    "FILEBEAT_LOG_GLOB": "${SERVICE_ROOT}/logs/*.log",
    "FILEBEAT_OUTPUT_HOST": "${OPENOBSERVE_URL}",
    "FILEBEAT_OUTPUT_PATH": "/api/default/",
    "FILEBEAT_OUTPUT_INDEX": "default",
    "FILEBEAT_OUTPUT_USERNAME": "root@service-lasso.local",
    "FILEBEAT_OUTPUT_PASSWORD": "service-lasso-openobserve",
    "FILEBEAT_OUTPUT_TIMEOUT": "10",
    "FILEBEAT_DATA_DIR": "${SERVICE_ROOT}/runtime/data",
    "FILEBEAT_LOG_DIR": "${SERVICE_ROOT}/logs"
  },
  "globalenv": {
    "FILEBEAT_HTTP_URL": "http://${FILEBEAT_HTTP_HOST}:${FILEBEAT_HTTP_PORT}",
    "FILEBEAT_HTTP_PORT": "${FILEBEAT_HTTP_PORT}",
    "FILEBEAT_LOG_GLOB": "${FILEBEAT_LOG_GLOB}"
  },
  "urls": [
    {
      "label": "Filebeat metrics",
      "url": "http://${FILEBEAT_HTTP_HOST}:${FILEBEAT_HTTP_PORT}/",
      "kind": "local"
    }
  ],
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-filebeat",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-filebeat-8.14.2-win32.zip",
        "archiveType": "zip",
        "command": "./filebeat.exe",
        "args": []
      },
      "linux": {
        "assetName": "lasso-filebeat-8.14.2-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./filebeat",
        "args": []
      },
      "darwin": {
        "assetName": "lasso-filebeat-8.14.2-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./filebeat",
        "args": []
      }
    }
  },
  "commandline": {
    "win32": "-c \"${SERVICE_ROOT}\\runtime\\filebeat.yml\" -e --path.home \"${SERVICE_ARTIFACT_ROOT}\" --path.config \"${SERVICE_ROOT}\\runtime\" --path.data \"${FILEBEAT_DATA_DIR}\" --path.logs \"${FILEBEAT_LOG_DIR}\"",
    "linux": "-c \"${SERVICE_ROOT}/runtime/filebeat.yml\" -e --path.home \"${SERVICE_ARTIFACT_ROOT}\" --path.config \"${SERVICE_ROOT}/runtime\" --path.data \"${FILEBEAT_DATA_DIR}\" --path.logs \"${FILEBEAT_LOG_DIR}\"",
    "darwin": "-c \"${SERVICE_ROOT}/runtime/filebeat.yml\" -e --path.home \"${SERVICE_ARTIFACT_ROOT}\" --path.config \"${SERVICE_ROOT}/runtime\" --path.data \"${FILEBEAT_DATA_DIR}\" --path.logs \"${FILEBEAT_LOG_DIR}\""
  },
  "install": {
    "files": [
      {
        "path": "./runtime/data/.keep",
        "content": ""
      },
      {
        "path": "./logs/.keep",
        "content": ""
      }
    ]
  },
  "config": {
    "files": [
      {
        "path": "./runtime/filebeat.yml",
        "content": "setup.ilm.enabled: false\nsetup.template.enabled: false\n\nfilebeat.inputs:\n  - type: filestream\n    id: service-lasso-files\n    enabled: true\n    paths:\n      - '${FILEBEAT_LOG_GLOB}'\n\noutput.elasticsearch:\n  hosts: ['${FILEBEAT_OUTPUT_HOST}']\n  timeout: ${FILEBEAT_OUTPUT_TIMEOUT}\n  path: '${FILEBEAT_OUTPUT_PATH}'\n  index: '${FILEBEAT_OUTPUT_INDEX}'\n  username: '${FILEBEAT_OUTPUT_USERNAME}'\n  password: '${FILEBEAT_OUTPUT_PASSWORD}'\n  allow_older_versions: true\n\nhttp.enabled: true\nhttp.host: '${FILEBEAT_HTTP_HOST}'\nhttp.port: ${FILEBEAT_HTTP_PORT}\n\nlogging.to_files: true\nlogging.files.path: '${FILEBEAT_LOG_DIR}'\nlogging.to_stderr: true\n"
      }
    ]
  },
  "setup": {
    "steps": {
      "setup-dashboards": {
        "description": "Run Filebeat setup against the configured Elasticsearch-compatible output when the target stack supports it.",
        "depend_on": ["openobserve"],
        "commandline": {
          "win32": "\"${SERVICE_ARTIFACT_ROOT}\\filebeat.exe\" setup -e -c \"${SERVICE_ROOT}\\runtime\\filebeat.yml\" --path.home \"${SERVICE_ARTIFACT_ROOT}\" --path.config \"${SERVICE_ROOT}\\runtime\" --path.data \"${FILEBEAT_DATA_DIR}\" --path.logs \"${FILEBEAT_LOG_DIR}\"",
          "default": "\"${SERVICE_ARTIFACT_ROOT}/filebeat\" setup -e -c \"${SERVICE_ROOT}/runtime/filebeat.yml\" --path.home \"${SERVICE_ARTIFACT_ROOT}\" --path.config \"${SERVICE_ROOT}/runtime\" --path.data \"${FILEBEAT_DATA_DIR}\" --path.logs \"${FILEBEAT_LOG_DIR}\""
        },
        "timeoutSeconds": 180,
        "rerun": "manual"
      }
    }
  },
  "healthcheck": {
    "type": "http",
    "url": "http://${FILEBEAT_HTTP_HOST}:${FILEBEAT_HTTP_PORT}/",
    "expected_status": 200,
    "retries": 80,
    "interval": 250
  },
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  },
  "meta": {
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-filebeat.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-filebeat/blob/main/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-filebeat/issues",
    "upstreamUrl": "https://www.elastic.co/beats/filebeat",
    "tags": [
      "service-lasso",
      "filebeat",
      "logs",
      "observability",
      "openobserve"
    ]
  }
}
